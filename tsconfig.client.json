{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "noEmit": true
  },
  "include": ["src/client/**/*.ts", "src/shared/**/*.ts", "src/ui/**/*.ts"],
  "exclude": ["src/ui/**/*.test.ts"]
}
